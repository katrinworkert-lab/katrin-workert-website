---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import schreibtischBuch from '../assets/fotos/schreibtisch-buch.jpg';
import portraet from '../assets/fotos/portraet.jpg';
import badge from '../assets/dia-badge.png';

const DIA = 'Diplom-Sachverständige (DIA) für die Bewertung von bebauten und unbebauten Grundstücken, für Mieten und Pachten';
const MAIL = 'kontakt@katrin-workert.de';
const TEL = '05172 5993813';
const TEL_LINK = 'tel:+4951725993813';
const mailto = `mailto:${MAIL}?subject=${encodeURIComponent('Anfrage Immobilienbewertung')}`;
// Orte des Arbeitsgebiets. Diese Liste steuert Texte, Seitentitel und Angaben für Suchmaschinen.
// Reihenfolge: Kerngebiet zuerst. Die ersten drei Orte erscheinen im Seitentitel und in der Abzeichen-Leiste.
const ORTE = ['Peine', 'Hildesheim', 'Salzgitter', 'Wolfenbüttel', 'Gifhorn', 'Celle', 'Lehrte', 'Wolfsburg', 'Braunschweig', 'Hannover'];
const orteText = ORTE.slice(0, -1).join(', ') + ' und ' + ORTE.at(-1);
const orteKurz = ORTE.slice(0, 3).join(', ');
const title = `Immobilienbewertung ${orteKurz} – Katrin Workert`;
const description = `Immobilienbewertung für Erben, Familien und private Eigentümer: Verkehrswertgutachten und Kurzbewertung in ${orteKurz} und Umgebung. Auf Wunsch Beratung, was der Wert für Ihre weitere Planung bedeutet.`;

const anlaesse = [
  ['Erbschaft mit Immobilie', 'Sie haben eine Immobilie geerbt – allein oder gemeinsam mit anderen. Was ist sie wert, und was ist der nächste sinnvolle Schritt? Eine nachvollziehbare Wertermittlung schafft die Grundlage.'],
  ['Halten oder verkaufen?', 'Veränderte Lebenssituation oder Ruhestand: Sie überlegen, ob Sie eine Immobilie halten, vermieten, verpachten oder verkaufen. Auf Grundlage des Werts vergleiche ich in einer Beratung Ihre Möglichkeiten wirtschaftlich, bevor Sie sich festlegen.'],
  ['Zweitmeinung zur Maklereinschätzung', 'Sie haben bereits eine Einschätzung erhalten und möchten wissen, ob sie realistisch ist. Ich prüfe sie anhand der Marktdaten und des Zustands der Immobilie.'],
  ['Schenkung und Übertragung', 'Sie möchten Immobilien zu Lebzeiten an die nächste Generation übertragen und benötigen dafür eine belastbare Wertgrundlage – auch zur Vorbereitung von Gesprächen mit Steuerberater und Notar.'],
  ['Mehrere Immobilien in der Familie', 'Mehrere Objekte, unterschiedliche Zustände, unklare Reihenfolge der nächsten Schritte: In der strategischen Bestandsberatung erfasse ich den Bestand und ordne Werte und Möglichkeiten so, dass die Familie ihr Immobilienvermögen auf einer gemeinsamen Grundlage planen kann.'],
  ['Trennung und Scheidung', 'Sie möchten sich über den Wert der gemeinsamen Immobilie einigen. Für die einvernehmliche Regelung erstelle ich eine Werteinschätzung oder ein Verkehrswertgutachten, bei Bedarf zu zwei Bewertungsstichtagen.'],
  ['Pflichtteilsfragen', 'Für Pflichtteilsansprüche ist der Immobilienwert häufig die zentrale Größe. Ein nachvollziehbares Verkehrswertgutachten gibt allen Beteiligten dieselbe Grundlage für die außergerichtliche Klärung.'],
];


const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Katrin Workert – Immobilienbewertung',
  description,
  url: Astro.site.href,
  email: MAIL,
  telephone: '+49 5172 5993813',
  areaServed: ORTE.map((name) => ({ '@type': 'City', name })),
  founder: {
    '@type': 'Person',
    name: 'Katrin Workert',
    jobTitle: DIA,
    alumniOf: [{ '@type': 'CollegeOrUniversity', name: 'Deutsche Immobilien-Akademie an der Universität Freiburg' }],
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Leistungen',
    itemListElement: [
      ['Verkehrswertgutachten', 'Wertermittlung nach § 194 BauGB und ImmoWertV für Erbschaft, Übertragung in der Familie, einvernehmliche Regelungen bei Trennung, Pflichtteilsfragen und Verkaufsverhandlungen.'],
      ['Kurzbewertung / Marktwertanalyse', 'Werteinschätzung als Zweitmeinung, als Grundlage für eine Einigung in der Familie oder als Vorstufe zu einem vollständigen Gutachten.'],
      ['Beratung zu einer Immobilie', 'Wirtschaftlicher Vergleich der Möglichkeiten nach der Bewertung: halten, verkaufen, vermieten oder übertragen.'],
      ['Strategische Bestandsberatung', 'Strukturierte Erfassung und Planungsgrundlage für Familien und Eigentümer mit mehreren Immobilien, etwa für die Übergabe an die nächste Generation.'],
    ].map(([name, d]) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name, description: d } })),
  },
  knowsAbout: ['Verkehrswertgutachten', 'Immobilienbewertung', 'Grundstücksbewertung', 'ImmoWertV', 'Immobilie geerbt', 'Erbengemeinschaft', 'Pflichtteil', 'Zugewinnausgleich', 'Marktwertanalyse'],
};
---
<Base title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />

  <section class="hero" id="top">
    <div class="hero-grid">
      <div class="hero-text">
        <h1>Immobilien&shy;bewertung für Erben, Familien und private Eigentümer.</h1>
        <p class="hero-lead">Ob geerbte Immobilie, Verkauf oder mehrere Immobilien in der Familie: Ich erstelle Kurzbewertungen und Verkehrswertgutachten. Ergänzend biete ich Beratung für einzelne Immobilien und ganze Bestände an.</p>
        <p class="hero-kern">Ich ermittle, was Ihre Immobilie wert ist. Auf Wunsch berate ich Sie, was das für Ihre weitere Planung bedeutet.</p>
        <div class="hero-actions">
          <a class="btn" href="#kontakt">Erstgespräch anfragen</a>
          <a class="btn btn-ghost" href="#leistungen">Leistungen ansehen</a>
        </div>
        <p class="hero-hinweis">Das Erstgespräch ist kostenlos und unverbindlich.</p>
      </div>
      <div class="hero-photo">
        <Image src={schreibtischBuch} alt="Katrin Workert am Schreibtisch mit Fachliteratur und einer Flurkarte" widths={[640, 960, 1280, 1840]} sizes="(max-width: 62rem) 100vw, 45vw" loading="eager" fetchpriority="high" quality={72} />
      </div>
    </div>
  </section>

  <section class="nachweis" aria-label="Qualifikation und Arbeitsgebiet">
    <dl class="wrap nachweis-grid">
      <a class="nachweis-badge" href="https://www.dia.de/de/657/?credential=9bc7de5b-ac8c-4379-9234-6c0209a08592" target="_blank" rel="noopener" title="Qualifikation bei der Deutschen Immobilien-Akademie verifizieren">
        <Image src={badge} alt="Abzeichen der Deutschen Immobilien-Akademie an der Universität Freiburg" width={352} />
      </a>
      <div>
        <dt>Qualifikationsnachweis</dt>
        <dd class="titel">{DIA}</dd>
        <dd><a class="verify" href="https://www.dia.de/de/657/?credential=9bc7de5b-ac8c-4379-9234-6c0209a08592" target="_blank" rel="noopener">Qualifikation verifizieren<span class="sr"> (öffnet in neuem Tab)</span></a></dd>
      </div>
      <div class="nachweis-neben">
        <div>
          <dt>Arbeitsweise</dt>
          <dd>Persönlich vor Ort, schriftliches Angebot vor jedem Auftrag</dd>
        </div>
        <div>
          <dt>Region</dt>
          <dd>{orteKurz} und Umgebung. Weitere Orte auf Anfrage.</dd>
        </div>
      </div>
    </dl>
  </section>

  <section class="section anlaesse" id="anlaesse">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Typische Anlässe</p>
        <h2>Wann eine Bewertung weiterhilft.</h2>
        <p>Die meisten Bewertungsanlässe entstehen aus konkreten Lebenssituationen – häufig in der Familie. In diesen Situationen unterstütze ich Sie mit einer belastbaren, nachvollziehbaren Wertermittlung und auf Wunsch mit einer Beratung.</p>
      </div>
      <ul class="anlaesse-list">
        {anlaesse.map(([t, d]) => (
          <li>
            <h3>{t}</h3>
            <p>{d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="leistungen">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Leistungen</p>
        <h2>Bewertung als Grundlage. Beratung dort, wo sie gebraucht wird.</h2>
        <p>Bewertung und Beratung sind zwei getrennte Leistungen. Sie können eine Bewertung allein beauftragen und auf Wunsch eine Beratung anschließen, auch auf Grundlage eines vorhandenen Gutachtens.</p>
        <p class="stufen-hinweis"><strong>Nicht jede Frage braucht ein Verkehrswertgutachten.</strong> Im kostenlosen Erstgespräch klären wir, welche Leistung für Ihren Anlass ausreicht.</p>
      </div>

      <div class="leistungen-grid">
      <div class="leistungen-gruppe">
        <div class="gruppe-kopf">
          <h3>Bewertung</h3>
          <p>Was ist Ihre Immobilie am Stichtag wert? Das Ergebnis ist für alle Beteiligten dieselbe Grundlage.</p>
        </div>

        <article class="leistung">
          <div>
            <p class="leistung-rolle">Kernleistung</p>
            <h4>Verkehrswertgutachten</h4>
            <p class="leistung-desc">Für Eigentümer, Familien oder deren Berater, die eine belastbare Wertermittlung nach § 194 BauGB benötigen – methodisch fundiert nach ImmoWertV, mit ausführlichem Ortstermin und vollständiger schriftlicher Dokumentation.</p>
            <p class="leistung-typisch">Typische Anwendungsfälle: Vermögensteilung in der Familie, Vorbereitung von Übertragungen und Schenkungen, Verkaufsverhandlungen bei größerem Wertvolumen, einvernehmliche Regelungen bei Trennung und Scheidung, außergerichtliche Klärung von Pflichtteilsfragen.</p>
          </div>
          <div>
            <ul class="haken">
              <li>Vergleichswert-, Ertragswert- oder Sachwertverfahren nach ImmoWertV – je nach Objekttyp</li>
              <li>Ausführlicher Ortstermin mit Fotodokumentation</li>
              <li>Vollständiges schriftliches Gutachten (typisch 30–60 Seiten)</li>
              <li>Berücksichtigung von Rechten und Belastungen (z. B. Wohnrecht, Erbbaurecht)</li>
              <li>Prüfung vorhandener Wohn- und Nutzflächenberechnungen, bei Bedarf mit Korrektur</li>
              <li>Nachvollziehbare Herleitung – geeignet für Gespräche mit Steuerberater, Anwalt oder Makler</li>
              <li>Auf Wunsch erläutere ich Ihnen das Ergebnis am Telefon</li>
            </ul>
            <p class="hinweis">Für den Nachweis eines niedrigeren Werts gegenüber dem Finanzamt ist dieses Gutachten nicht vorgesehen. Kommt es zu einem Gerichtsverfahren, beauftragt das Gericht in der Regel selbst ein Gutachten. In beiden Fällen nenne ich Ihnen gern geeignete Kolleginnen und Kollegen.</p>
          </div>
          <p class="honorar"><strong>Honorar: ab 2.750 €</strong> je nach Verkehrswert und Aufwand</p>
        </article>

        <article class="leistung">
          <div>
            <p class="leistung-rolle">Der Einstieg</p>
            <h4>Kurzbewertung / Marktwertanalyse</h4>
            <p class="leistung-desc">Für Eigentümer und Familien, die eine fundierte Werteinschätzung brauchen, etwa als Zweitmeinung, als Grundlage für eine Einigung in der Familie oder als Vorstufe zu einem vollständigen Gutachten.</p>
            <p class="leistung-typisch">Typisch: geerbte Immobilie, Verkaufsüberlegung, Zweitmeinung zu einer Maklereinschätzung, Einigung in der Familie, Vorabklärung vor einem vollständigen Gutachten.</p>
          </div>
          <div>
            <ul class="haken">
              <li>Sichtung vorhandener Unterlagen</li>
              <li>Werteinschätzung nach anerkannten Verfahren</li>
              <li>Ortstermin in der Regel ja</li>
              <li>Zustand nach Augenschein, erkennbare Schäden werden benannt</li>
              <li>Kurze schriftliche Zusammenfassung (4–8 Seiten), auf Wunsch erläutere ich Ihnen das Ergebnis am Telefon</li>
              <li>Begründeter Hinweis, ob für Ihren Zweck ein vollständiges Gutachten nötig ist</li>
            </ul>
            <p class="hinweis">Die Kurzbewertung ist kein Verkehrswertgutachten nach § 194 BauGB. Für Gerichtsverfahren, die Vorlage beim Finanzamt und die Kreditsicherung ist sie nicht geeignet.</p>
          </div>
          <p class="honorar"><strong>Honorar: 600 bis 1.000 €</strong> als Pauschale, je nach Aufwand</p>
        </article>
      </div>

      <div class="leistungen-gruppe">
        <div class="gruppe-kopf">
          <h3>Beratung</h3>
          <p>Was bedeutet der Wert für Ihre weitere Planung, und welche Möglichkeiten haben Sie? Die Beratung ist ein eigener Auftrag, getrennt vom Gutachten.</p>
        </div>

        <article class="leistung">
          <div>
            <p class="leistung-rolle">Nach der Bewertung</p>
            <h4>Beratung zu einer Immobilie</h4>
            <p class="leistung-desc">Für Eigentümer und Familien, die nach der Bewertung wissen möchten, wie es mit ihrer Immobilie weitergehen kann und welche Möglichkeiten sie haben. Grundlage kann auch ein vorhandenes Gutachten sein.</p>
            <p class="leistung-typisch">Typisch: geerbte Immobilie, veränderte Lebenssituation, Ruhestand, Vermietung statt Verkauf.</p>
          </div>
          <ul class="haken">
            <li>Möglichkeiten wie halten, verkaufen, vermieten oder übertragen, wirtschaftlich verglichen</li>
            <li>Grundlage sind der Wert, Erträge und Kosten aus Unterlagen oder Fachgutachten und Ihre Lebenssituation</li>
            <li>Gespräch, auf Wunsch mit kurzer schriftlicher Zusammenfassung</li>
          </ul>
          <p class="honorar"><strong>Honorar: 170 € je Stunde</strong> in der Regel zwei bis vier Stunden</p>
        </article>

        <article class="leistung">
          <div>
            <p class="leistung-rolle">Für mehrere Objekte</p>
            <h4>Strategische Bestandsberatung</h4>
            <p class="leistung-desc">Für Familien und private Eigentümer mit mehreren Immobilien, die ihr Immobilienvermögen langfristig planen möchten, etwa für die Übergabe an die nächste Generation.</p>
            <p class="leistung-kern">Ich schaffe Klarheit über Werte, Optionen und nächste sinnvolle Schritte.</p>
            <p class="leistung-desc">Vergütet werde ich ausschließlich über das vorab vereinbarte Honorar.</p>
            <p class="leistung-typisch">Typisch: mehrere Immobilien in Familienhand, Erbfall mit gemischtem Bestand, Übergabe oder Neuordnung, unklare Reihenfolge der nächsten Schritte.</p>
          </div>
          <ul class="haken">
            <li>Strukturierte Erfassung des Bestands</li>
            <li>Bewertung oder Werteinschätzung der einzelnen Objekte</li>
            <li>Einordnung von Nutzung, Ertrag und wirtschaftlicher Bedeutung</li>
            <li>Ortstermine bei allen relevanten Objekten</li>
            <li>Möglichkeiten je Objekt: halten, verkaufen, vermieten, verpachten, zunächst sichern oder weiter prüfen</li>
            <li>Ausführlicher schriftlicher Bericht und zwei bis drei Beratungsgespräche</li>
          </ul>
          <p class="honorar"><strong>Honorar: 5.000 bis 10.000 €</strong> je nach Objektzahl und Komplexität</p>
        </article>
      </div>
      </div>

      <p class="preis-fuss">Vor jedem Auftrag erhalten Sie ein schriftliches Angebot. Alle Beträge sind Endpreise. Gemäß § 19 UStG wird keine Umsatzsteuer berechnet. Das Honorar für Verkehrswertgutachten berechne ich in Anlehnung an die Honorarrichtlinie Immobilienbewertung 2026 des BVS. Es richtet sich nach dem ermittelten Wert. Das Angebot nennt Ihnen deshalb eine Spanne. Hinzu kommt eine Nebenkostenpauschale von 5 bis 10 % des Honorars. Fahrtkosten berechne ich mit 0,90 € je Kilometer. Behördliche Auskünfte wie Grundbuchauszug oder Flurkarte gebe ich ohne Aufschlag weiter. Ist ein neues Aufmaß mit Flächenberechnung nötig, weise ich es im Angebot gesondert aus.</p>
    </div>
  </section>

  <section class="section" id="ablauf">
    <div class="wrap ablauf-grid">
      <div>
        <p class="eyebrow">Ablauf</p>
        <h2>So läuft eine Bewertung ab.</h2>
        <ol class="schritte">
          <li>
            <h3>Erstgespräch</h3>
            <p>Sie schildern mir den Anlass und die Immobilie. Das Gespräch ist kostenlos und unverbindlich, und ich sage Ihnen offen, welche Leistung Sie wirklich brauchen.</p>
          </li>
          <li>
            <h3>Angebot</h3>
            <p>Sie erhalten ein schriftliches Angebot mit Leistungsumfang, Liefertermin und Honorar. Beim Verkehrswertgutachten richtet sich das Honorar nach dem ermittelten Wert. Im Angebot nenne ich Ihnen deshalb eine Spanne.</p>
          </li>
          <li>
            <h3>Unterlagen und Ortstermin</h3>
            <p>Ich sichte die vorhandenen Unterlagen, hole fehlende Auskünfte ein und besichtige die Immobilie. Beim Verkehrswertgutachten gehört der Ortstermin immer dazu.</p>
          </li>
          <li>
            <h3>Ergebnis</h3>
            <p>Sie erhalten das Ergebnis schriftlich und nachvollziehbar hergeleitet. Offene Fragen dazu klären wir im Gespräch.</p>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section dark" id="arbeitsweise">
    <svg class="flurkarte" viewBox="0 0 800 560" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
      <path d="M-20 150 C140 120 260 170 400 150 S660 90 830 130" /><path d="M-20 182 C140 152 260 202 400 182 S660 122 830 162" />
      <path d="M300 166 C310 280 280 380 300 580" /><path d="M330 168 C340 280 310 380 330 580" />
      <path d="M330 360 C460 340 600 380 830 350" /><path d="M330 390 C460 370 600 410 830 380" />
      <path d="M20 145 L30 20 M110 137 L118 10 M200 148 L205 10 M300 158 L300 10 M410 150 L405 10 M520 138 L512 10 M640 112 L628 10 M750 116 L742 10" />
      <path d="M-20 60 L800 44" />
      <path d="M40 180 L48 300 L296 290 M120 174 L126 296 M210 186 L214 293" />
      <path d="M48 300 L52 420 L298 412 M126 296 L132 418 M214 293 L218 415 M52 420 L56 560 M132 418 L140 560 M218 415 L224 560" />
      <path d="M336 178 L338 352 M440 180 L444 344 M550 168 L556 348 M670 138 L680 362 M338 262 L676 248" />
      <path d="M400 388 L408 560 M500 384 L510 560 M610 392 L622 560 M720 384 L734 560 M334 470 L830 452" />
      <path d="M550 168 L670 138 L675 248 L553 254 Z" fill="currentColor" fill-opacity="0.55" stroke-width="2.5" />
      <g stroke-width="1"><rect x="56" y="200" width="46" height="34" transform="rotate(-3 79 217)" /><rect x="140" y="212" width="52" height="30" transform="rotate(-3 166 227)" /><rect x="228" y="204" width="44" height="40" transform="rotate(-3 250 224)" />
      <rect x="64" y="322" width="48" height="36" transform="rotate(-3 88 340)" /><rect x="146" y="330" width="40" height="42" transform="rotate(-3 166 351)" /><rect x="232" y="324" width="50" height="32" transform="rotate(-3 257 340)" />
      <rect x="356" y="196" width="56" height="38" /><rect x="462" y="200" width="60" height="34" /><rect x="574" y="186" width="70" height="40" /><rect x="352" y="282" width="48" height="44" /><rect x="470" y="276" width="54" height="40" /><rect x="586" y="272" width="60" height="46" />
      <rect x="350" y="404" width="40" height="38" /><rect x="424" y="406" width="58" height="34" /><rect x="528" y="410" width="60" height="36" /><rect x="640" y="404" width="52" height="40" />
      <rect x="40" y="70" width="50" height="36" transform="rotate(-2 65 88)" /><rect x="132" y="66" width="46" height="40" transform="rotate(-2 155 86)" /><rect x="226" y="72" width="54" height="34" transform="rotate(-2 253 89)" /><rect x="330" y="74" width="50" height="38" /><rect x="434" y="66" width="56" height="40" /><rect x="544" y="56" width="60" height="36" /><rect x="660" y="54" width="54" height="38" /></g>
      <g fill="currentColor" stroke="none" font-family="Georgia, serif" font-size="13">
        <text x="68" y="268">112/4</text><text x="150" y="272">113</text><text x="236" y="270">114/2</text><text x="368" y="252">87</text><text x="474" y="254">88/1</text><text x="590" y="244">89</text><text x="76" y="394">121</text><text x="154" y="398">122/3</text><text x="236" y="392">123</text><text x="430" y="500">64/7</text><text x="540" y="504">65</text><text x="650" y="498">66/2</text>
      </g>
    </svg>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Arbeitsweise</p>
        <h2>Nachvollziehbar bewertet. Verständlich erklärt.</h2>
        <p>Der Verkehrswert zeigt, wie der Markt Ihre Immobilie sieht. Was er für Ihre weitere Planung bedeutet, klären wir auf Wunsch in einer Beratung.</p>
      </div>
      <ul class="aw-grid">
        <li>
          <h3>Praxis aus dem Gutachterausschuss</h3>
          <p>Mehrere Jahre habe ich hauptberuflich im Gutachterausschuss für Grundstückswerte gearbeitet, zuletzt als Vorsitzende. Wie amtliche Wertdaten entstehen und wo ihre Grenzen liegen, kenne ich aus eigener Arbeit.</p>
        </li>
        <li>
          <h3>Erfahrung mit Gebäudeschäden</h3>
          <p>Sechs Jahre habe ich ein Unternehmen für Gebäudeschadenbeseitigung geführt. Feuchte- und Gebäudeschäden erkenne ich deshalb bei der Besichtigung und benenne sie. Soweit möglich, beziffere ich die Kosten der Beseitigung überschlägig und berücksichtige sie im Wert. Für Ursachen und genaue Kosten empfehle ich ein Gutachten von Sachverständigen für Bauschäden.</p>
        </li>
        <li>
          <h3>Sachlich in Familiensituationen</h3>
          <p>Gerade bei Immobilien im Familienbesitz treffen wirtschaftliche Fragen auf unterschiedliche Erwartungen. Ich verstehe die emotionale Bindung an Immobilien – und arbeite auf Basis nachvollziehbarer Fakten, damit alle Beteiligten dieselbe Grundlage haben.</p>
        </li>
        <li>
          <h3>Beratung auf Wunsch</h3>
          <p>Nach der Bewertung vergleiche ich auf Wunsch Ihre Möglichkeiten wirtschaftlich: halten, verkaufen, vermieten oder übertragen. Dabei helfen mir die Volkswirtschaftslehre und der Blick als Eigentümerin. Die Beratung ist ein eigener Auftrag, getrennt vom Gutachten.</p>
        </li>
        <li>
          <h3>Nachvollziehbares Honorar</h3>
          <p>Die Honorare stehen auf dieser Seite. Beim Verkehrswertgutachten richtet sich das Honorar nach dem Wert der Immobilie und einer festen Tabelle. Im Angebot nenne ich Ihnen vorab eine Spanne. Das erste Gespräch ist kostenlos.</p>
        </li>
        <li>
          <h3>Persönlich</h3>
          <p>Von der ersten Anfrage bis zum Ergebnis haben Sie eine Ansprechpartnerin. Für jedes Verkehrswertgutachten besichtige ich die Immobilie selbst.</p>
        </li>
      </ul>
      <p class="abgrenzung"><strong>Gut zu wissen:</strong> Bewertungen für die Kreditvergabe beauftragt die Bank selbst. Rechtliche und steuerliche Gesichtspunkte beziehe ich ein, soweit sie für die Bewertung eines Grundstücks von Bedeutung sind – etwa Bauplanungsrecht, Baulasten oder Rechte und Belastungen im Grundbuch. Die rechtliche und steuerliche Beratung im Einzelfall bleibt bei Ihrem Anwalt, Notar oder Steuerberater. Mit ihnen arbeite ich auf Wunsch eng zusammen.</p>
    </div>
  </section>

  <section class="section ueber" id="ueber-mich">
    <div class="wrap ueber-grid">
      
      <div>
        <p class="eyebrow">Über mich</p>
        <h2>Katrin Workert</h2>
        <p class="ueber-titel">{DIA}</p>
        <div class="ueber-text">
          <p>Immobilien begleiten mich seit meiner Jugend. Mehrere Jahre war ich hauptberuflich im Gutachterausschuss für Grundstückswerte tätig und habe dort die amtliche Wertermittlung aus der Praxis kennengelernt. Zuletzt habe ich sechs Jahre lang ein Unternehmen für Gebäudeschadenbeseitigung geführt, in dem Bausubstanz, Schäden und Kosten zum Alltag gehörten.</p>
          <p>Studiert habe ich Volkswirtschaftslehre sowie Friedens- und Konfliktforschung. Das eine schärft meinen Blick für wirtschaftliche Möglichkeiten, das andere für den sachlichen Umgang mit unterschiedlichen Interessen.</p>
          <p>Ich lebe selbst in der Region, besitze eigene Immobilien und kenne die Fragen meiner Auftraggeber auch aus eigener Erfahrung.</p>
        </div>

        <div class="quali">
          <h3>Qualifikationen</h3>
          <ul>
            <li>{DIA}, berufsbegleitender Studiengang der Deutschen Immobilien-Akademie an der Universität Freiburg (vier Semester, 400 Unterrichtsstunden). <a href="https://www.dia.de/de/657/?credential=0702371f-3c2c-4436-aa83-3ac7802f62c9" target="_blank" rel="noopener">Diplom ansehen<span class="sr"> (öffnet in neuem Tab)</span></a></li>
            <li>Mehrjährige hauptberufliche Tätigkeit im Gutachterausschuss für Grundstückswerte, zunächst als Sachbearbeiterin, zuletzt als Vorsitzende</li>
            <li>Geschäftsführerin eines Unternehmens für Gebäudeschadenbeseitigung, 2020 bis 2026</li>
            <li>B.Sc. Volkswirtschaftslehre, M.A. Friedens- und Konfliktforschung</li>
            <li>Regelmäßige Fortbildung im Bereich der Immobilienwirtschaft</li>
          </ul>
        </div>
      </div>
      <div class="ueber-photo">
        <Image src={portraet} alt="Porträt von Katrin Workert" widths={[480, 720, 960, 1280]} sizes="(max-width: 62rem) 28rem, 42vw" quality={72} />
      </div>
    </div>
  </section>

  <section class="section" id="kontakt">
    <div class="wrap kontakt-grid">
      <div>
        <p class="eyebrow">Kontakt</p>
        <h2>Sprechen Sie mich an.</h2>
        <div class="kontakt-text">
          <p>Ob Sie einen belastbaren Wert brauchen oder planen, wie es mit Ihrem Immobilienbesitz weitergeht: Im kostenlosen und unverbindlichen Erstgespräch klären wir, welche Leistung zu Ihrer Situation passt.</p>
          <p>Tätig in {orteText}. Alle weiteren Orte auf Anfrage.</p>
        </div>
        <dl class="kontakt-daten">
          <div>
            <dt>Telefon</dt>
            <dd><a href={TEL_LINK}>{TEL}</a></dd>
          </div>
          <div>
            <dt>E-Mail</dt>
            <dd><a href={mailto}>{MAIL}</a></dd>
          </div>
          <div>
            <dt>Region</dt>
            <dd>{orteKurz} und Umgebung</dd>
          </div>
        </dl>
        {/* TODO vor Livegang: Link zur Terminbuchung eintragen */}
        <a class="btn btn-ghost termin-btn" href="#kontakt" data-platzhalter>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
          Termin online buchen
        </a>
      </div>

      {/* TODO vor Livegang: Formular an einen Versanddienst anschließen */}
      <form class="form" id="kontaktformular" novalidate>
        <div>
          <label for="name">Name</label>
          <input type="text" id="name" name="name" autocomplete="name" required placeholder="Ihr vollständiger Name" />
        </div>
        <div>
          <label for="email">E-Mail</label>
          <input type="email" id="email" name="email" autocomplete="email" required placeholder="ihre@email.de" />
        </div>
        <div class="form-paar">
          <div>
            <label for="telefon">Telefon <span class="optional">(freiwillig)</span></label>
            <input type="tel" id="telefon" name="telefon" autocomplete="tel" inputmode="tel" placeholder="Für einen Rückruf" />
          </div>
          <div>
            <label for="erreichbar">Am besten erreichbar</label>
            <select id="erreichbar" name="erreichbar">
              <option value="">Bitte wählen …</option>
              <option>Werktags vormittags</option>
              <option>Werktags mittags</option>
              <option>Werktags nachmittags</option>
              <option>Samstags</option>
              <option>Lieber per E-Mail</option>
            </select>
          </div>
        </div>
        <div>
          <label for="leistung">Gewünschte Leistung</label>
          <select id="leistung" name="leistung">
            <option value="">Bitte wählen …</option>
            <option>Kurzbewertung / Marktwertanalyse</option>
            <option>Verkehrswertgutachten</option>
            <option>Beratung zu einer Immobilie</option>
            <option>Strategische Bestandsberatung</option>
            <option>Noch unklar – im Erstgespräch klären</option>
          </select>
        </div>
        <div>
          <label for="anlass">Anlass der Bewertung</label>
          <select id="anlass" name="anlass">
            <option value="">Bitte wählen …</option>
            <option>Erbschaft</option>
            <option>Schenkung / Übertragung</option>
            <option>Trennung / Scheidung</option>
            <option>Pflichtteil</option>
            <option>Kauf- oder Verkaufsüberlegung</option>
            <option>Zweitmeinung zu vorhandener Einschätzung</option>
            <option>Mehrere Objekte / Bestandsordnung</option>
            <option>Sonstiges</option>
          </select>
        </div>
        <div>
          <label for="nachricht">Ihre Situation</label>
          <textarea id="nachricht" name="nachricht" placeholder="Beschreiben Sie kurz die Immobilie und Ihre Frage …"></textarea>
        </div>
        <label class="check" for="datenschutz">
          <input type="checkbox" id="datenschutz" name="datenschutz" required />
          <span>Ich habe die <a href="/datenschutz/">Datenschutzerklärung</a> gelesen und stimme der Verarbeitung meiner Daten zu.</span>
        </label>
        <button class="btn" type="submit">Nachricht senden</button>
        <p class="form-meldung" id="form-meldung" role="status" hidden>Entwurf: Das Formular ist noch nicht angeschlossen. Es wird noch nichts verschickt.</p>
      </form>
    </div>
  </section>

  <div class="kontaktleiste" id="kontaktleiste" hidden>
    <a class="btn btn-ghost" href={TEL_LINK}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2" /></svg>
      Anrufen<span class="sr"> unter {TEL}</span>
    </a>
    <a class="btn" href="#kontakt"><span class="leiste-lang">Erstgespräch anfragen</span><span class="leiste-kurz" aria-hidden="true">Anfragen</span></a>
  </div>

  <script is:inline>
    (function () {
      var l = document.getElementById('kontaktleiste');
      var hero = document.querySelector('.hero-actions');
      var kontakt = document.getElementById('kontakt');
      if (!l || !hero || !kontakt || !('IntersectionObserver' in window)) return;
      var sicht = { hero: true, kontakt: false };
      function set() { l.hidden = sicht.hero || sicht.kontakt; }
      new IntersectionObserver(function (e) { sicht.hero = e[0].isIntersecting || e[0].boundingClientRect.top > 0; set(); }).observe(hero);
      new IntersectionObserver(function (e) { sicht.kontakt = e[0].isIntersecting; set(); }).observe(kontakt);
    })();
  </script>

  <script is:inline>
    (function () {
      var f = document.getElementById('kontaktformular');
      if (!f) return;
      f.addEventListener('submit', function (e) {
        e.preventDefault();
        document.getElementById('form-meldung').hidden = false;
      });
    })();
  </script>
</Base>
